---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostsSection from '../../components/PostsSection';

const allPosts = (await getCollection('posts'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const posts = allPosts.map((p) => ({
  slug: p.slug,
  title: p.data.title,
  date: p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
  description: p.data.description,
}));
---
<BaseLayout
  title="Posts — Sergio Castiñeyras"
  description="Writing on cloud architecture, AWS, observability, CI/CD, cost optimization, and engineering leadership by Sergio Castiñeyras."
>
  <PostsSection posts={posts} client:only="react" />
</BaseLayout>
